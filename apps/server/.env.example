# Copy to .env for local development. Matches the db service in compose.yaml.
DATABASE_URL=postgres://warfront:warfront@localhost:5434/warfront
PORT=3100
# Comma-separated origins allowed to open a Socket.IO connection.
CLIENT_ORIGINS=http://localhost:5173
# Signs access tokens; any random string of 32+ characters. Change it outside local development.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
